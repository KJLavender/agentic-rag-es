# Elasticsearch superuser 密碼：只給 docker compose 和 npm run es:setup 用，app 本身不用它
ELASTIC_PASSWORD=change-me
ES_URL=http://127.0.0.1:9200
# npm run es:setup 會產生下面兩把 API key 寫進 .env.local
# ES_INGEST_API_KEY=   可寫入 rag-chunks（ingestion、上傳文件）
# ES_SEARCH_API_KEY=   只能讀 rag-chunks（MCP retrieval server）

OLLAMA_URL=http://127.0.0.1:11434
# npm run setup:model 會從 LLM_BASE_MODEL 建一個 16k context 的變體 LLM_MODEL
LLM_BASE_MODEL=qwen3.5:4b
LLM_MODEL=rag-qwen3.5-4b
EMBED_MODEL=bge-m3
EMBED_DIMS=1024
PORT=8787

# docker compose 裡 app 和 MCP server 之間的 Bearer token（至少 16 字元）
MCP_TOKEN=change-me-to-a-long-random-string

# rerank 後端（MCP search 的 rerank=true）：cross-encoder（預設，程序內 CPU）| rerank-api | systemone | llm
# RERANKER=cross-encoder
# RERANK_URL=http://127.0.0.1:8093/v1/rerank       rerank-api：llama-server --reranking
# RERANK_URL=http://127.0.0.1:8091/v1/systemone    systemone：llama.cpp 的 decision model
# RERANK_FORMAT=pair                               systemone 的問法：pair | doc | choice
# RERANK_TIMEOUT_MS=15000                          逾時就用原本的排序
# 送到本機以外（例如 Jev 雲端版）會把文件片段送出去，要明確打開：
# RERANK_ALLOW_REMOTE=1
# RERANK_API_KEY=                                  放 .env.local，不要 commit
