# Elasticsearch superuser 密碼：只給 docker compose 和 npm run es:setup 用，app 本身不用它
ELASTIC_PASSWORD=change-me
ES_URL=http://127.0.0.1:9200
# npm run es:setup 會產生下面兩把 API key 寫進 .env.local
# ES_INGEST_API_KEY=   可寫入 rag-chunks（ingestion、上傳文件）
# ES_SEARCH_API_KEY=   只能讀 rag-chunks（MCP retrieval server）

OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:4b
EMBED_MODEL=bge-m3
EMBED_DIMS=1024
PORT=8787
